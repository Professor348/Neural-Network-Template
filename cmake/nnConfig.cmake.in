@PACKAGE_INIT@
if(@NN_ENABLE_NPU@ AND NOT TARGET openvino::runtime)
    include(CMakeFindDependencyMacro)
    find_dependency(OpenVINO 2024.6 COMPONENTS Runtime)
endif()
if(@NN_ENABLE_GPU@ AND NOT TARGET OpenCL::OpenCL)
    find_library(NN_OPENCL_LIBRARY NAMES OpenCL)
    if(NOT NN_OPENCL_LIBRARY)
        set(nn_FOUND FALSE)
        set(nn_NOT_FOUND_MESSAGE "This nn build requires an OpenCL loader library")
        return()
    endif()
    add_library(OpenCL::OpenCL UNKNOWN IMPORTED)
    set_target_properties(OpenCL::OpenCL PROPERTIES IMPORTED_LOCATION "${NN_OPENCL_LIBRARY}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/nnTargets.cmake")
check_required_components(nn)
